class Solution {
    public int missingNumber(int[] nums) {

        int ans1 = 0;
        int ans2 = 0;

        int[] start = new int[nums.length + 1];

        start[0] = 0;

        for (int i = 1; i <= nums.length; i++) {
            start[i] = start[i - 1] + 1;
        }

        for (int j = 0; j < nums.length; j++) {
            ans1 ^= nums[j];
            ans2 ^= start[j];
        }

        ans2 ^= start[nums.length];

        return ans1 ^ ans2;
    }
}